# Copy to .env and replace the tokens: openssl rand -hex 24
PORT=8787
HOST=0.0.0.0
DATA_DIR=data
# Directory holding web/ and assets/ (the repo root by default)
STATIC_DIR=..
INGEST_TOKEN=change-me-ingest
DISPLAY_TOKEN=change-me-display
SESSION_RETAIN_MIN=30
SILENT_SUSPECT_MIN=10
# Advertise the hub on the LAN as _deskling._tcp for displays to discover (0 = off, e.g. on AWS)
MDNS=1
# Print one line per ingested event (1 = on)
LOG_EVENTS=0
